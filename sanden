<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>株式会社山源 | 正しい提案を、正しいプロセスで。</title>

<meta name="description" content="株式会社山源は、太陽光発電・蓄電池を中心とした再生可能エネルギー事業を通じて、人・情報・資源が集まり、新しい価値が生まれる源を目指します。">

<meta name="theme-color" content="#0A0A0A">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700&family=Shippori+Mincho:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

/* =========================================================
   SANGEN CORPORATE WEBSITE
   Color Concept
   White / Black / Navy / Gold
========================================================= */

:root{
  --white:#FFFFFF;
  --off-white:#F7F7F5;
  --black:#090A0C;
  --black-soft:#111317;

  --navy:#0E2542;
  --navy-light:#173A63;

  --gold:#C9A55C;
  --gold-dark:#A77D31;
  --gold-light:#E7D8B7;

  --text:#17202D;
  --text-soft:#5D6570;

  --line:#DCDDDD;

  --max-width:1180px;

  --serif:'Shippori Mincho',serif;
  --sans:'Noto Sans JP',sans-serif;
}


/* =========================================================
   RESET
========================================================= */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:var(--sans);
  color:var(--text);
  background:var(--white);
  line-height:1.9;
  font-weight:400;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}

img{
  display:block;
  width:100%;
  height:auto;
}

a{
  color:inherit;
  text-decoration:none;
}

button{
  font:inherit;
}

::selection{
  background:var(--gold);
  color:var(--black);
}


/* =========================================================
   COMMON
========================================================= */

.container{
  width:min(calc(100% - 64px),var(--max-width));
  margin:0 auto;
}

.section{
  padding:120px 0;
}

.section-black{
  background:var(--black);
  color:var(--white);
}

.section-navy{
  background:var(--navy);
  color:var(--white);
}

.section-gray{
  background:var(--off-white);
}

.section-title{
  margin-bottom:60px;
}

.section-label{
  display:flex;
  align-items:center;
  gap:14px;

  color:var(--gold-dark);

  font-size:11px;
  font-weight:600;
  letter-spacing:.28em;
  text-transform:uppercase;

  margin-bottom:18px;
}

.section-label::before{
  content:"";
  width:30px;
  height:1px;
  background:var(--gold);
}

.section-black .section-label,
.section-navy .section-label{
  color:var(--gold);
}

.section-title h2{
  font-family:var(--serif);
  font-size:clamp(30px,4vw,48px);
  line-height:1.6;
  letter-spacing:.06em;
  font-weight:600;
}

.section-title p{
  margin-top:20px;
  max-width:720px;
  color:var(--text-soft);
  font-size:15px;
}

.section-black .section-title p,
.section-navy .section-title p{
  color:rgba(255,255,255,.68);
}


/* =========================================================
   HEADER
========================================================= */

.header{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  z-index:999;

  background:rgba(255,255,255,.96);

  border-bottom:1px solid rgba(0,0,0,.08);

  transition:.3s ease;
}

.header.scrolled{
  box-shadow:0 8px 30px rgba(0,0,0,.08);
}

.header-inner{
  width:min(calc(100% - 64px),var(--max-width));
  height:82px;
  margin:auto;

  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  display:flex;
  align-items:center;
  gap:12px;
}

.logo-mark{
  width:43px;
  height:43px;
}

.logo-name{
  font-family:var(--serif);
  font-size:18px;
  font-weight:700;
  letter-spacing:.12em;
}

.logo-name small{
  display:block;

  margin-top:-3px;

  font-family:var(--sans);
  font-size:8px;
  font-weight:500;
  letter-spacing:.28em;

  color:var(--gold-dark);
}

.nav{
  display:flex;
  align-items:center;
  gap:30px;
}

.nav a{
  position:relative;

  font-size:12px;
  font-weight:500;
  letter-spacing:.08em;
}

.nav a::after{
  content:"";

  position:absolute;
  left:0;
  bottom:-7px;

  width:0;
  height:1px;

  background:var(--gold);

  transition:.3s ease;
}

.nav a:hover::after{
  width:100%;
}

.header-contact{
  padding:11px 18px;

  background:var(--black);
  color:var(--white);

  font-size:11px;
  letter-spacing:.12em;

  transition:.3s ease;
}

.header-contact:hover{
  background:var(--gold-dark);
}


/* =========================================================
   MOBILE MENU
========================================================= */

.menu-button{
  display:none;

  width:44px;
  height:44px;

  border:1px solid var(--line);
  background:var(--white);

  cursor:pointer;
}

.menu-button span{
  display:block;

  width:20px;
  height:1px;

  margin:5px auto;

  background:var(--black);

  transition:.3s ease;
}

.mobile-menu{
  display:none;

  position:fixed;
  top:82px;
  left:0;

  width:100%;

  background:var(--white);

  border-top:1px solid var(--line);

  padding:25px;
}

.mobile-menu.open{
  display:block;
}

.mobile-menu a{
  display:block;

  padding:16px 0;

  border-bottom:1px solid var(--line);

  font-size:14px;
  letter-spacing:.08em;
}


/* =========================================================
   HERO
========================================================= */

.hero{
  position:relative;

  min-height:100vh;

  display:flex;
  align-items:flex-end;

  padding-top:82px;

  background:var(--black);

  overflow:hidden;
}

.hero-image{
  width:100%;
}

.hero-image img{
  width:100%;
  height:auto;
  display:block;
}

.hero-overlay{
  position:absolute;
  inset:0;

  background:
    linear-gradient(
      90deg,
      rgba(5,6,8,.82) 0%,
      rgba(5,6,8,.38) 45%,
      rgba(5,6,8,.05) 80%
    );
}

.hero-content{
  position:absolute;

  left:0;
  bottom:12%;

  width:min(calc(100% - 64px),var(--max-width));

  margin:auto;
  right:0;

  color:var(--white);
}

.hero-label{
  display:flex;
  align-items:center;
  gap:14px;

  margin-bottom:25px;

  color:var(--gold);

  font-size:12px;
  letter-spacing:.28em;
}

.hero-label::before{
  content:"";

  width:38px;
  height:1px;

  background:var(--gold);
}

.hero h1{
  font-family:var(--serif);

  font-size:clamp(38px,6vw,74px);

  line-height:1.55;

  letter-spacing:.08em;

  margin-bottom:25px;
}

.hero h1 span{
  color:var(--gold);
}

.hero-description{
  max-width:620px;

  color:rgba(255,255,255,.78);

  font-size:15px;
}

.hero-buttons{
  display:flex;
  gap:14px;

  margin-top:35px;
}

.button{
  display:inline-flex;

  align-items:center;
  justify-content:center;

  min-width:190px;

  padding:16px 28px;

  font-size:12px;
  letter-spacing:.14em;

  border:1px solid var(--gold);

  transition:.3s ease;
}

.button-gold{
  background:var(--gold);
  color:var(--black);
}

.button-gold:hover{
  background:var(--white);
  border-color:var(--white);
}

.button-outline{
  color:var(--white);
}

.button-outline:hover{
  background:var(--white);
  color:var(--black);
}


/* =========================================================
   INTRO
========================================================= */

.intro{
  background:var(--white);
}

.intro-grid{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:90px;

  align-items:center;
}

.intro-copy h2{
  font-family:var(--serif);

  font-size:clamp(28px,3.5vw,45px);

  line-height:1.7;

  letter-spacing:.06em;
}

.intro-copy h2 span{
  color:var(--gold-dark);
}

.intro-copy p{
  margin-top:25px;

  color:var(--text-soft);

  font-size:15px;
}

.intro-card{
  position:relative;

  padding:55px 45px;

  background:var(--black);

  color:var(--white);

  overflow:hidden;
}

.intro-card::after{
  content:"";

  position:absolute;

  right:-70px;
  bottom:-80px;

  width:240px;
  height:240px;

  border:1px solid rgba(201,165,92,.5);

  transform:rotate(45deg);
}

.intro-card-label{
  color:var(--gold);

  font-size:11px;
  letter-spacing:.25em;

  margin-bottom:20px;
}

.intro-card h3{
  position:relative;
  z-index:2;

  font-family:var(--serif);

  font-size:25px;

  line-height:1.8;
}

.intro-card p{
  position:relative;
  z-index:2;

  margin-top:20px;

  color:rgba(255,255,255,.68);

  font-size:13px;
}


/* =========================================================
   IMAGE PANELS
========================================================= */

.visual-section{
  padding:0;

  background:var(--white);
}

.visual-image{
  width:100%;

  background:var(--white);

  border-top:1px solid rgba(0,0,0,.06);
  border-bottom:1px solid rgba(0,0,0,.06);
}

.visual-image img{
  width:100%;
  height:auto;

  object-fit:contain;

  /* 元画像をトリミングしない */
}

.visual-caption{
  padding:70px 20px;

  text-align:center;
}

.visual-caption .label{
  color:var(--gold-dark);

  font-size:10px;
  letter-spacing:.28em;

  margin-bottom:16px;
}

.visual-caption h2{
  font-family:var(--serif);

  font-size:clamp(26px,3.5vw,42px);

  line-height:1.7;

  letter-spacing:.06em;
}

.visual-caption p{
  max-width:680px;

  margin:18px auto 0;

  color:var(--text-soft);

  font-size:14px;
}


/* =========================================================
   PHILOSOPHY
========================================================= */

.philosophy{
  background:var(--black);

  color:var(--white);
}

.philosophy-intro{
  max-width:760px;

  margin-bottom:65px;
}

.philosophy-intro h2{
  font-family:var(--serif);

  font-size:clamp(28px,4vw,46px);

  line-height:1.7;

  letter-spacing:.06em;
}

.philosophy-intro p{
  margin-top:22px;

  color:rgba(255,255,255,.68);

  font-size:14px;
}

.philosophy-grid{
  display:grid;

  grid-template-columns:repeat(3,1fr);

  gap:1px;

  background:rgba(255,255,255,.15);
}

.philosophy-card{
  padding:45px 35px;

  background:var(--black);

  border-top:2px solid transparent;

  transition:.3s ease;
}

.philosophy-card:hover{
  border-top-color:var(--gold);
}

.philosophy-number{
  color:var(--gold);

  font-family:var(--serif);

  font-size:14px;

  letter-spacing:.15em;

  margin-bottom:20px;
}

.philosophy-card h3{
  font-family:var(--serif);

  font-size:21px;

  line-height:1.7;

  margin-bottom:18px;
}

.philosophy-card p{
  color:rgba(255,255,255,.62);

  font-size:13px;

  line-height:2;
}


/* =========================================================
   BUSINESS
========================================================= */

.business{
  background:var(--off-white);
}

.business-grid{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:2px;

  background:var(--line);
}

.business-card{
  background:var(--white);

  padding:55px 45px;
}

.business-card .number{
  color:var(--gold-dark);

  font-family:var(--serif);

  font-size:13px;

  letter-spacing:.18em;

  margin-bottom:20px;
}

.business-card h3{
  font-family:var(--serif);

  font-size:27px;

  margin-bottom:18px;
}

.business-card .lead{
  color:var(--text-soft);

  font-size:14px;

  margin-bottom:28px;
}

.business-list{
  list-style:none;
}

.business-list li{
  padding:13px 0;

  border-top:1px solid var(--line);

  font-size:13px;

  color:var(--text-soft);

  display:flex;
  gap:12px;
}

.business-list li::before{
  content:"—";

  color:var(--gold-dark);

  flex-shrink:0;
}


/* =========================================================
   STRENGTHS
========================================================= */

.strengths{
  background:var(--white);
}

.strength-grid{
  display:grid;

  grid-template-columns:repeat(3,1fr);

  border-top:1px solid var(--line);
  border-left:1px solid var(--line);
}

.strength{
  padding:40px 30px;

  border-right:1px solid var(--line);
  border-bottom:1px solid var(--line);
}

.strength-number{
  color:var(--gold-dark);

  font-family:var(--serif);

  font-size:25px;

  margin-bottom:18px;
}

.strength h3{
  font-family:var(--serif);

  font-size:18px;

  margin-bottom:12px;
}

.strength p{
  color:var(--text-soft);

  font-size:13px;

  line-height:1.9;
}


/* =========================================================
   COMPANY OVERVIEW
========================================================= */

.company{
  background:var(--navy);

  color:var(--white);
}

.company-grid{
  display:grid;

  grid-template-columns:.8fr 1.2fr;

  gap:70px;
}

.company-copy h2{
  font-family:var(--serif);

  font-size:clamp(28px,3.5vw,42px);

  line-height:1.7;
}

.company-copy p{
  margin-top:20px;

  color:rgba(255,255,255,.68);

  font-size:14px;
}

.company-table{
  width:100%;

  border-collapse:collapse;

  background:rgba(255,255,255,.04);
}

.company-table tr{
  border-top:1px solid rgba(255,255,255,.14);
}

.company-table tr:first-child{
  border-top:none;
}

.company-table th,
.company-table td{
  padding:21px 22px;

  text-align:left;

  vertical-align:top;

  font-size:13px;
}

.company-table th{
  width:30%;

  color:var(--gold);

  font-weight:600;

  letter-spacing:.08em;

  white-space:nowrap;
}

.company-table td{
  color:rgba(255,255,255,.88);
}


/* =========================================================
   HISTORY
========================================================= */

.history{
  background:var(--white);
}

.history-list{
  border-top:1px solid var(--line);
}

.history-item{
  display:grid;

  grid-template-columns:160px 1fr;

  gap:35px;

  padding:28px 0;

  border-bottom:1px solid var(--line);
}

.history-date{
  color:var(--gold-dark);

  font-family:var(--serif);

  font-size:15px;
}

.history-content strong{
  display:block;

  margin-bottom:5px;

  font-family:var(--serif);

  font-size:17px;
}

.history-content{
  color:var(--text-soft);

  font-size:14px;
}


/* =========================================================
   FINAL VISUAL
========================================================= */

.final-visual{
  background:var(--black);

  padding:0;
}

.final-visual img{
  width:100%;
  height:auto;

  object-fit:contain;
}


/* =========================================================
   VISION
========================================================= */

.vision{
  padding:130px 20px;

  background:var(--white);

  text-align:center;
}

.vision .label{
  color:var(--gold-dark);

  font-size:11px;
  letter-spacing:.3em;

  margin-bottom:25px;
}

.vision h2{
  font-family:var(--serif);

  font-size:clamp(28px,4vw,48px);

  line-height:1.8;

  letter-spacing:.08em;
}

.vision h2 span{
  color:var(--gold-dark);
}

.vision p{
  max-width:650px;

  margin:25px auto 0;

  color:var(--text-soft);

  font-size:14px;

  line-height:2;
}


/* =========================================================
   CONTACT
========================================================= */

.contact{
  background:var(--black);

  color:var(--white);

  padding:110px 0;
}

.contact-grid{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:80px;

  align-items:center;
}

.contact h2{
  font-family:var(--serif);

  font-size:clamp(28px,4vw,46px);

  line-height:1.7;

  letter-spacing:.06em;
}

.contact-description{
  margin-top:20px;

  color:rgba(255,255,255,.65);

  font-size:14px;
}

.contact-card{
  padding:45px;

  border:1px solid rgba(201,165,92,.5);

  background:rgba(255,255,255,.035);
}

.contact-row{
  display:grid;

  grid-template-columns:100px 1fr;

  gap:20px;

  padding:18px 0;

  border-top:1px solid rgba(255,255,255,.12);
}

.contact-row:first-child{
  border-top:none;
}

.contact-key{
  color:var(--gold);

  font-size:10px;

  letter-spacing:.18em;
}

.contact-value{
  color:rgba(255,255,255,.88);

  font-size:14px;
}

.contact-button{
  display:block;

  margin-top:28px;

  width:100%;

  padding:17px;

  text-align:center;

  background:var(--gold);

  color:var(--black);

  font-size:12px;

  font-weight:600;

  letter-spacing:.12em;

  transition:.3s ease;
}

.contact-button:hover{
  background:var(--white);
}


/* =========================================================
   FOOTER
========================================================= */

.footer{
  background:#050505;

  color:rgba(255,255,255,.6);

  border-top:1px solid rgba(255,255,255,.12);

  padding:35px 0;
}

.footer-inner{
  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:20px;
}

.footer-logo{
  display:flex;

  align-items:center;

  gap:10px;

  color:var(--white);

  font-size:12px;

  letter-spacing:.08em;
}

.footer-logo svg{
  width:25px;
  height:25px;
}

.footer small{
  font-size:10px;

  letter-spacing:.05em;
}


/* =========================================================
   SCROLL ANIMATION
========================================================= */

.reveal{
  opacity:0;

  transform:translateY(25px);

  transition:
    opacity .8s ease,
    transform .8s ease;
}

.reveal.show{
  opacity:1;

  transform:none;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1000px){

  .nav{
    display:none;
  }

  .menu-button{
    display:block;
  }

  .header-contact{
    display:none;
  }

  .intro-grid{
    grid-template-columns:1fr;

    gap:50px;
  }

  .company-grid{
    grid-template-columns:1fr;

    gap:50px;
  }

  .contact-grid{
    grid-template-columns:1fr;

    gap:50px;
  }

  .philosophy-grid{
    grid-template-columns:1fr;
  }

  .strength-grid{
    grid-template-columns:1fr 1fr;
  }

}


@media(max-width:760px){

  .container{
    width:min(calc(100% - 36px),var(--max-width));
  }

  .header-inner{
    width:calc(100% - 36px);
    height:72px;
  }

  .mobile-menu{
    top:72px;
  }

  .logo-mark{
    width:37px;
    height:37px;
  }

  .logo-name{
    font-size:16px;
  }

  .section{
    padding:80px 0;
  }

  .hero{
    min-height:auto;

    padding-top:72px;

    display:block;
  }

  .hero-image{
    position:relative;
  }

  .hero-overlay{
    background:
      linear-gradient(
        180deg,
        rgba(5,6,8,.05) 0%,
        rgba(5,6,8,.25) 40%,
        rgba(5,6,8,.9) 100%
      );
  }

  .hero-content{
    position:absolute;

    bottom:8%;

    width:calc(100% - 36px);
  }

  .hero h1{
    font-size:clamp(30px,9vw,48px);
  }

  .hero-description{
    font-size:13px;
  }

  .hero-buttons{
    flex-direction:column;

    width:100%;
  }

  .button{
    width:100%;
  }

  .business-grid{
    grid-template-columns:1fr;
  }

  .strength-grid{
    grid-template-columns:1fr;
  }

  .history-item{
    grid-template-columns:1fr;

    gap:8px;
  }

  .company-table,
  .company-table tbody,
  .company-table tr,
  .company-table th,
  .company-table td{
    display:block;

    width:100%;
  }

  .company-table tr{
    padding:18px 20px;
  }

  .company-table th{
    padding:0 0 7px;

    white-space:normal;
  }

  .company-table td{
    padding:0;
  }

  .contact-card{
    padding:28px 22px;
  }

  .contact-row{
    grid-template-columns:1fr;

    gap:5px;
  }

  .footer-inner{
    flex-direction:column;

    align-items:flex-start;
  }

  .visual-caption{
    padding:55px 20px;
  }

}


@media(prefers-reduced-motion:reduce){

  html{
    scroll-behavior:auto;
  }

  *,
  *::before,
  *::after{
    animation-duration:.001ms!important;
    transition-duration:.001ms!important;
  }

